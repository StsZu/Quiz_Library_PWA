{
  "name": "quiz-library-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "python3 scripts/import_quizzes.py content/courses.json public/content",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4175",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "check": "npm run lint && npm run build && node scripts/check-build.mjs && node scripts/size.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "idb": "8.0.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.58.2",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
